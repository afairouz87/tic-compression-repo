# macOS
.DS_Store

# Claude
CLAUDE.md
.claude/

# VS Code
.vscode/

# Logs
*.log
nohup.out

# Debug
*.dSYM/

# Backup folders
results_backup/

# Tool output directories removed from the release artifact.
# debug_pic_tic.py and run_search_v1.py recreate these on demand
# (os.makedirs(..., exist_ok=True)); they must not return to the artifact.
search_outputs/
debug_pic_tic_outputs/

# Generated experiment output. Runners write everything under results/:
#   results/raw/      *_results.csv
#   results/tables/   *_table.tex
#   results/figures/  *.png
#   results/logs/     run logs
#   results/tmp/      scratch
# Directory-based ignore, so nothing under results/ is ever committed.
/results/

# Belt and braces: catch generated artifacts written to the repository root by
# an older script or a manual run. Scoped with a leading slash so only the root
# is affected -- docs/, datasets/manifest.csv and the source tree are untouched.
/*_results.csv
/*_table.tex
/parallel_*.png

# Compiled binaries. Both are Make targets and must be built locally with
# `make`; the committed macOS/arm64 copies were removed from the artifact.
/epic-v3.1
/pic-v3.1

# Python cache
__pycache__/
*.pyc
# Benchmark datasets (multi-gigabyte, rebuilt by prepare_datasets.py).
# The manifest and the per-dataset source lists are small and are kept.
/datasets/*
!/datasets/manifest.csv
!/datasets/manifests/

# Source corpora and dataset-pipeline working directories
/standard_ebooks_output/
/gutenberg_ebooks/
/combined_text_files/
/data/
